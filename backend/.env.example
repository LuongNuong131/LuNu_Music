# LuNu Music backend secrets — never commit real values.
# Use either GEMINI_API_KEYS as a comma-separated list, or individual slots below.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEYS=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
LUNU_AI_RATE_LIMIT_COUNT=12

# YouTube download on Render: export a Netscape-format cookie jar from a
# logged-in browser, then set ONE of these in Render Environment Variables or
# Secret Files. Cookies are required when YouTube challenges the Render IP.
YOUTUBE_COOKIES_B64=
YOUTUBE_COOKIES_PATH=/etc/secrets/youtube-cookies.txt
# Optional comma-separated fallback order. Keep the defaults unless debugging.
YOUTUBE_PLAYER_CLIENTS=web_embedded,mweb,web,tv
# Optional YouTube Data API key improves search only; it does not replace cookies for downloads.
YOUTUBE_API_KEY=
# Timeout for official YouTube Data API search requests.
YOUTUBE_API_TIMEOUT_SECONDS=20
LUNU_AUDIO_UPLOAD_MAX_BYTES=209715200
