# Frontend (Vercel)
VITE_API_URL=https://your-render-service.onrender.com/api

# Backend (Render)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-key
# Optional but recommended: official YouTube Data API v3 key for deterministic search results
YOUTUBE_API_KEY=
# Optional only if YouTube asks Render to verify the user is not a bot.
# Prefer a secure base64 Netscape cookies.txt value; never commit cookies.txt.
YOUTUBE_COOKIES_B64=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
LUNU_AUTH_SECRET=replace-with-a-long-random-secret
# New song uploads start at 199 by default because the legacy catalog contains 188 originals.
LUNU_SONG_START_SEQUENCE=199
CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173
