# Frontend (Vercel)
VITE_API_URL=https://your-render-service.onrender.com/api

# Backend (Render)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-supabase-key
# Optional but recommended: official YouTube Data API v3 key for deterministic search results
YOUTUBE_API_KEY=
YOUTUBE_API_TIMEOUT_SECONDS=20
# Optional: Jamendo developer application ID. Without it, Internet Archive remains available.
JAMENDO_CLIENT_ID=
# Timeout and safety policy for direct-download providers.
LUNU_DIRECT_SOURCE_TIMEOUT_SECONDS=20
LUNU_ALLOW_UNLICENSED_ARCHIVE=false
LUNU_AUDIO_UPLOAD_MAX_BYTES=209715200
# Optional only if YouTube asks Render to verify the user is not a bot.
# Prefer a secure base64 Netscape cookies.txt value; never commit cookies.txt.
YOUTUBE_COOKIES_B64=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
LUNU_AUTH_SECRET=replace-with-a-long-random-secret
# New song uploads start at 199 by default because the legacy catalog contains 188 originals.
LUNU_SONG_START_SEQUENCE=199
CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173

# Optional: move YouTube extraction to your own machine/VPS with a different egress IP.
# Run backend/media_worker.py behind HTTPS; never deploy it to the same blocked IP.
LUNU_MEDIA_WORKER_URL=
LUNU_MEDIA_WORKER_TOKEN=
LUNU_MEDIA_WORKER_TIMEOUT_SECONDS=600
# Wait between attempts after YouTube returns a block/challenge (per API process).
YOUTUBE_COOLDOWN_SECONDS=900
# Let current yt-dlp select suitable player clients by default.
YOUTUBE_PLAYER_CLIENTS=default
